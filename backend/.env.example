# PB08 TAXI - Backend Environment Variables

# Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://pb08taxi.vercel.app

# Database (Neon.tech PostgreSQL)
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/pb08taxi?sslmode=require
# If left empty, SQLite (sqlite:///./pb08taxi.db) is used for local zero-config testing.
DATABASE_URL=

# Security & Admin Authentication
JWT_SECRET=supersecret-pb08-taxi-jwt-key-change-this-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials (Auto-created during seed/initial run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=PB08Taxi@2026!
ADMIN_EMAIL=admin@pb08taxi.com

# OpenWA WhatsApp Gateway (https://github.com/rmyndharis/OpenWA)
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_NAME=pb08-taxi
# Set to true if OpenWA is not currently running to simulate sends and prevent connection errors during development
OPENWA_SIMULATOR_MODE=false

# Support & Contact info (used in messages and website)
SUPPORT_PHONE=+919876543210
SUPPORT_WHATSAPP=+919876543210
BUSINESS_NAME=PB08 TAXI
